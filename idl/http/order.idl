// order.idl

enum OrderStatus {
    Pending = 0
    Paid = 1
    Shipped = 2
}

type Order  {
    string id
    string user_id
    float amount
    OrderStatus status
}

type CreateOrderReq {
    string id
    string user_id
    float amount
}

type CreateOrderResp Response<Order?>

rpc CreateOrder(CreateOrderReq) CreateOrderResp {
    method="POST"
    path="/createOrder"
}

type PayOrderReq {
    string id
}

type PayOrderResp Response<Order?>

rpc PayOrder(PayOrderReq) PayOrderResp {
    method="POST"
    path="/payOrder"
}

type ShipOrderReq {
    string id
}

type ShipOrderResp Response<Order?>

rpc ShipOrder(ShipOrderReq) ShipOrderResp {
    method="POST"
    path="/shipOrder"
}
